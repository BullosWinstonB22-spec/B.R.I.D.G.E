# ============================================================
# B.R.I.D.G.E — Backend (Django) environment
# Copy to: backend.env   (do NOT commit the real file)
# These names are read EXACTLY by backend/bridge_core/settings.py
# ============================================================

# Django core — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-50-char-random-string

# Set to True only on your local machine. MUST be False on Render.
DEBUG=True

# Comma-separated. On Render include .onrender.com; add your custom domain if any.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated list of frontend origins allowed to call the API.
# After Firebase deploy, add: https://<project-id>.web.app,https://<project-id>.firebaseapp.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database ------------------------------------------------
# Leave EMPTY to use SQLite (local dev). On Render this is auto-filled
# by render.yaml with the internal Postgres connection string.
# Format: postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# ---- Firebase Admin (optional, only if backend verifies ID tokens) ----
# Path (relative to backend/) or full path to the service-account JSON.
# FIREBASE_CREDENTIALS_PATH=../.env/serviceAccountKey.json
# FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Google OAuth (migrated from old BMS; optional) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- Old BMS variable mapping (reference only — NOT used by Django) ----
# BMS_HOST / PORT            -> handled by Render + gunicorn
# BMS_ALLOWED_ORIGINS        -> CORS_ALLOWED_ORIGINS (above)
# BMS_DATABASE_PATH          -> SQLite only; use DATABASE_URL for Postgres
# MONGODB_URI                -> retired; data migrated to PostgreSQL/SQLite
# BMS_ADMIN_PASSWORD         -> set via: python manage.py createsuperuser
# TOKEN_TTL_SECONDS / BMS_RATE_LIMIT_* -> DRF throttling (enable in settings)
